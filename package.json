{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test --config=test/e2e/playwright.config.ts",
    "test:unit": "vitest run",
    "test:a11y": "playwright test --config=test/e2e/playwright.config.ts test/e2e/25-accessibility.spec.ts --project=chromium",
    "test:perf": "playwright test --config=test/e2e/playwright.config.ts test/e2e/26-performance.spec.ts --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "graphql-codegen --config codegen.ts",
    "format": "prettier --write \"**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.2.0",
    "@dnd-kit/core": "6.3.1-next-202411517925",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@dnd-kit/sortable": "10.0.0-next-202410244445",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "date-fns": "^4.3.0",
    "docx": "9.5.1",
    "driver.js": "^1.8.0",
    "exceljs": "4.4.0",
    "graphql": "^16.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "zen-observable-ts": "^1.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
