# Public values only. Never place service credentials in this file.
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL used by Next.js server-side workers. In Docker use http://backend:8000.
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAPHQL_URI=http://localhost:8000/graphql/
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep this aligned with APP_ENCRYPTION_ENABLED in the backend.
NEXT_PUBLIC_APP_ENCRYPTION_ENABLED=true
# Required for signed local upload URLs. Use a random value of at least 32 bytes.
UPLOAD_FIRMA_SECRET=
